# Copy to .env.production on the EC2 host and fill in. Never commit the real file.
# Read by docker compose (variable substitution) and passed into the API container.
# ENVIRONMENT, NODE_ENV, PORT and TRUST_PROXY are pinned in docker-compose.prod.yml.
# Keep comments on their own lines: inline "# ..." after a value is not portable.

# ---------- Deployment image (GitHub Actions builds and pushes this; EC2 only pulls it) ----------
GHCR_OWNER=tanviranjum0
API_IMAGE_TAG=latest

# ---------- Compose / edge ----------
# Starts the bundled Redis container. Delete this line to use Upstash (Option B below).
COMPOSE_PROFILES=local-redis
# Public hostname of this server; Cloudflare DNS A record (grey cloud / DNS-only) -> Elastic IP.
API_DOMAIN=api.rideshare.tanvirdev.site
# Let's Encrypt expiry notices; any mailbox you check.
LETSENCRYPT_EMAIL=

# ---------- Auth ----------
# Generate each with: openssl rand -base64 48   (>= 32 chars, all different)
JWT_SECRET=
OTP_HASH_SECRET=
JWT_ISSUER=rideback-api
JWT_AUDIENCE=rideback-client

# ---------- Browser origins ----------
# Exact https origins, comma-separated, no trailing slash. CLIENT_URL must be one of them.
FRONTEND_ORIGINS=https://rideshare.tanvirdev.site
CLIENT_URL=https://rideshare.tanvirdev.site

# ---------- MongoDB Atlas (M0) ----------
# Atlas > Network Access: allow only this instance's Elastic IP (/32), not 0.0.0.0/0.
MONGODB_PROD_URL=mongodb+srv://tanviranjum010_db_user:9dTeNNRWDAGBz9GR@cluster0.krlc3yh.mongodb.net
MONGODB_MAX_POOL_SIZE=10

# ---------- Redis ----------
# Option A (default): bundled container. The password must match in both lines.
REDIS_PASSWORD=
REDIS_URL=redis://default:SAME_AS_REDIS_PASSWORD@redis:6379
# Option B: Upstash (TLS, note the rediss:// scheme). Read the quota warning in deploy/README.md first.
# REDIS_URL=rediss://default:UPSTASH_PASSWORD@YOUR-DB.upstash.io:6379

BACKGROUND_JOB_CONCURRENCY=5

# ---------- Two-factor authentication ----------
# Encrypts stored authenticator secrets. Set once, before the first sign-up, and keep it stable:
# rotating it (or JWT_SECRET when this is unset) invalidates every enrolled authenticator.
# Generate with: openssl rand -base64 48
TWO_FACTOR_KEY=
# Number shown in the in-trip safety toolkit.
EMERGENCY_NUMBER=112

# ---------- Integrations ----------
# Server-side Google Maps Platform key; the only source of map data. Enable on its project:
# Geocoding API, Places API (New), Routes API. Restrict by API (and by IP where the host has one).
# NOT the same key as RideFront's VITE_GOOGLE_MAPS_API_KEY (browser key, Maps JavaScript API,
# HTTP-referrer restricted): a key can only carry one application restriction type.
GOOGLE_MAPS_API=
RESEND_API=
# Must be on tanvirdev.site (or a subdomain), verified in Resend via Cloudflare DNS.
RESEND_EMAIL_FROM=no-reply@tanvirdev.site
