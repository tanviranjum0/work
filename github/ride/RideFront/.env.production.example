# Production build variables. Set these in the host's dashboard
# (Cloudflare Pages / Vercel → Settings → Environment Variables), not in a committed file.
# Every VITE_* value is compiled into the public JavaScript bundle: never put a secret here.

# API origin on the EC2 instance; shares the registrable domain tanvirdev.site with this site
# (required for the refresh cookie to survive Safari's third-party cookie blocking).
VITE_SERVER_URL=https://api.rideshare.tanvirdev.site
VITE_ENVIRONMENT=production
VITE_RIDE_TIMEOUT=90000

# Browser-visible key used for reverse geocoding. It cannot be referrer-restricted for the
# Geocoding web service, so give it a tiny daily quota until that call moves server-side.
VITE_GOOGLE_MAPS_API_KEY=
