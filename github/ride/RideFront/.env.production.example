# Vercel > Project > Settings > Environment Variables. Every VITE_* value is public.

# REST calls go to /api on the same origin; vercel.json rewrites that to the Render API.
# Same-origin keeps the refresh cookie first-party (works in Safari / with 3rd-party cookies blocked).
VITE_SERVER_URL=/api
# Socket.IO can't pass through a rewrite, so it talks to the API host directly.
VITE_SOCKET_URL=https://quickride-api-zh85.onrender.com
VITE_ENVIRONMENT=production
VITE_RIDE_TIMEOUT=90000
