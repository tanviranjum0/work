{
  "name": "aeronova",
  "private": true,
  "description": "Flight discovery and booking workflow platform (React + Express). Visual brand: AeroNova.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <25",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @aeronova/api\" \"npm run dev -w @aeronova/web\"",
    "dev:api": "npm run dev -w @aeronova/api",
    "dev:web": "npm run dev -w @aeronova/web",
    "build": "npm run build -w @aeronova/api && npm run build -w @aeronova/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "~4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}